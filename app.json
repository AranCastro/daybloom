{
  "expo": {
    "name": "Daybloom",
    "slug": "daybloom",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybloom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "online.draran.daybloom",
      "supportsTablet": false
    },
    "android": {
      "package": "online.draran.daybloom",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Daybloom",
      "themeColor": "#2F4A3F",
      "backgroundColor": "#F6F2EC"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#12110F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F4A3F"
        }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Daybloom to read the contact you pick, so you can call or message them in one tap."
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/600SemiBold/Fraunces_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
            "./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Matrix",
              "label": "Daybloom · Eisenhower Matrix",
              "description": "All four quadrants with your tasks",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "520dp",
              "maxResizeHeight": "620dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/matrix.png"
            },
            {
              "name": "Circle",
              "label": "Daybloom · People circle",
              "description": "Call or message your circle",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "520dp",
              "maxResizeHeight": "620dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/circle.png"
            },
            {
              "name": "CheckIn",
              "label": "Daybloom · Check in",
              "description": "Tap your mood from the home screen",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/checkin.png"
            },
            {
              "name": "Tasks",
              "label": "Daybloom · Focus today",
              "description": "Your top tasks; tick them off",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/tasks.png"
            },
            {
              "name": "Garden",
              "label": "Daybloom · Garden",
              "description": "Your latest flower and blooms",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/garden.png"
            },
            {
              "name": "Focus",
              "label": "Daybloom · Focus timer",
              "description": "Start a focus session in one tap",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "260dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/focus.png"
            },
            {
              "name": "Streak",
              "label": "Daybloom · Streak",
              "description": "Your check-in streak",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "260dp",
              "maxResizeHeight": "120dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/streak.png"
            },
            {
              "name": "Reach",
              "label": "Daybloom · Reach out",
              "description": "Call or message someone in your circle",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "120dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/reach.png"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "description": "Grow a little every day: a one-tap mood check-in, tasks, focus timer, calm games and your circle, all growing one garden. After a few low days, one trusted friend is quietly asked to call you.",
    "backgroundColor": "#F6F2EC",
    "primaryColor": "#2F4A3F"
  }
}
